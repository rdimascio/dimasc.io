    "@lesto/kernel": "^0.2.0",
    "@lesto/runtime": "^0.2.0",
    "@lesto/seo": "^0.2.0",
    "@lesto/sites": "^0.2.0",
    "@lesto/styles": "^0.2.0",
    "@lesto/ui": "^0.2.0",
    "@lesto/web": "^0.2.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "^19.0.0",
