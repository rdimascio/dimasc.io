{
	"name": "dimasc-io",
	"main": "worker.ts",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "dimasc.io", "custom_domain": true },
		{ "pattern": "www.dimasc.io", "custom_domain": true }
	],
	"assets": {
		"directory": "./out/www",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	}
}
